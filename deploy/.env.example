# ---- Required -------------------------------------------------------------------------------
# Long random string. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Fernet key(s) that encrypt stored API keys. BACK THIS UP: losing it makes stored keys unreadable.
# Generate: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Rotation: prepend a new key (comma-separated), run `manage rotate_encryption_key`, then drop the old key.
REVIEWBOT_ENCRYPTION_KEYS=
# Database password for the bundled Postgres.
POSTGRES_PASSWORD=

# Public URL of this instance as seen by browsers and GitHub (no trailing slash).
# GitHub must be able to reach ${REVIEWBOT_PUBLIC_URL}/webhooks/github.
REVIEWBOT_PUBLIC_URL=http://localhost:3000

# ---- Optional -------------------------------------------------------------------------------
# Hostnames Django accepts (the public hostname is added automatically).
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
# Set to true when the public URL is HTTPS (auto-detected from REVIEWBOT_PUBLIC_URL).
# REVIEWBOT_SECURE_COOKIES=true
# Set to true when a TLS-terminating proxy sets X-Forwarded-Proto.
# REVIEWBOT_BEHIND_PROXY=true
# Domain for the optional Caddy profile (automatic HTTPS).
# REVIEWBOT_DOMAIN=reviewbot.example.com
# Host port for the dashboard.
# REVIEWBOT_HTTP_PORT=3000

# GitHub Enterprise Server: set both to your instance.
# GITHUB_URL=https://github.example.com
# GITHUB_API_URL=https://github.example.com/api/v3

# Offline demo provider with canned findings (for trying Reviewbot without an API key).
# REVIEWBOT_ENABLE_FAKE_PROVIDER=false

# Logging: json | console ; level: DEBUG | INFO | WARNING
# LOG_FORMAT=json
# LOG_LEVEL=INFO
# Protect /metrics with a bearer token.
# REVIEWBOT_METRICS_TOKEN=
# Worker tuning.
# CELERY_CONCURRENCY=4
# REVIEWBOT_LLM_TIMEOUT_SECONDS=180
# REVIEWBOT_LLM_MAX_RETRIES=4

# Team and sign-in (see docs/configuration.md → "Team and sign-in").
# Let GitHub users without an invite join (as viewers), optionally only from these verified email domains.
# REVIEWBOT_ALLOW_SIGNUP=false
# REVIEWBOT_SIGNUP_EMAIL_DOMAINS=example.com
# SMTP for invite emails; without it the dashboard shows the invite link to share yourself.
# REVIEWBOT_EMAIL_HOST=smtp.example.com
# REVIEWBOT_EMAIL_USER=
# REVIEWBOT_EMAIL_PASSWORD=
# REVIEWBOT_EMAIL_FROM=reviewbot@example.com
# REVIEWBOT_AUDIT_RETENTION_DAYS=365
